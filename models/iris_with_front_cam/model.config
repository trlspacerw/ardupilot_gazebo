<?xml version="1.0"?>

<model>
  <name>Iris with Front Camera</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <description>
    Starting with iris_with_gimbal
    add front-facing fixed camera on base_link
  </description>
  <depend>
    <model>
      <uri>model://iris_with_gimbal</uri>
      <version>2.0</version>
    </model>
  </depend>
</model>
